{
  "name": "@sxzz/test-utils",
  "type": "module",
  "version": "0.5.20",
  "description": "Collection of common test utils.",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/sxzz/test-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/test-utils.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/test-utils/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@ts-macro/language-plugin": "*",
    "@volar/typescript": "*",
    "@vue/language-core": "^3.1.0",
    "esbuild": ">=0.20.0",
    "rolldown": "*",
    "rollup": "^4.1.0",
    "typescript": "^5.8.0 || ^6.0.0",
    "vitest": "^2.0.0 || ^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@ts-macro/language-plugin": {
      "optional": true
    },
    "@volar/typescript": {
      "optional": true
    },
    "@vue/language-core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "tinyglobby": "^0.2.17",
    "unplugin-utils": "^0.3.2"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.7.0",
    "@sxzz/prettier-config": "^2.3.3",
    "@ts-macro/language-plugin": "^0.3.7",
    "@types/node": "^26.6.5",
    "@typescript/native-preview": "npm:typescript@~7.0.2",
    "@volar/typescript": "^2.4.28",
    "@vue/language-core": "^3.3.13",
    "bumpp": "^12.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.13",
    "rollup": "^4.64.5",
    "ts-macro": "^0.3.7",
    "tsdown": "^0.23.1",
    "tsdown-preset-sxzz": "^0.7.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "prettier": "@sxzz/prettier-config"
}
